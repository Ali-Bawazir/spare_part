#: accounts/forms.py:109
msgid ""
"Inactive users cannot sign in. Prefer deactivating over deleting an account."
msgstr ""
"لا يمكن للمستخدمين غير النشطين تسجيل الدخول. يُفضَّل إلغاء التفعيل بدلًا من حذف "
"الحساب."

#: accounts/forms.py:146
msgid ""
"You cannot remove your own Super Admin access or deactivate yourself here."
msgstr ""
"لا يمكنك إزالة صلاحية المسؤول الأعلى لنفسك أو إلغاء تفعيل حسابك من هنا."

#: accounts/forms.py:152
msgid ""
"Another active Super Admin or Django superuser is required before demoting, "
"deactivating, or changing this account."
msgstr ""
"يلزم وجود مسؤول أعلى نشط آخر أو مستخدم Django خارق قبل تخفيض الرتبة أو إلغاء "
"التفعيل أو تعديل هذا الحساب."

#: accounts/management/commands/create_mms_user.py:12
msgid ""
"Create a real MMS user (production-style): username, role, optional staff "
"flag, and optional Django admin permissions for maintenance/inventory/"
"procurement."
msgstr ""
"إنشاء مستخدم MMS حقيقي (بنمط الإنتاج): اسم المستخدم، والدور، وعلامة الموظف "
"الاختيارية، وصلاحيات إدارة Django الاختيارية للصيانة والمخزون والمشتريات."

#: accounts/management/commands/create_mms_user.py:17
msgid "Login name (no spaces)."
msgstr "اسم الدخول (بدون مسافات)."

#: accounts/management/commands/create_mms_user.py:29
msgid "MMS role."
msgstr "دور MMS."

#: accounts/management/commands/create_mms_user.py:31
msgid "Email address."
msgstr "عنوان البريد الإلكتروني."

#: accounts/management/commands/create_mms_user.py:37
msgid ""
"Allow login to /admin/ (still needs model permissions unless --grant-admin-"
"apps)."
msgstr ""
"السماح بتسجيل الدخول إلى /admin/ (لا تزال تحتاج صلاحيات النموذج ما لم يُمرَّر --"
"grant-admin-apps)."

#: accounts/management/commands/create_mms_user.py:42
msgid ""
"Django superuser (full admin). Prefer createsuperuser unless you know you "
"need this."
msgstr ""
"مستخدم Django خارق (إدارة كاملة). يُفضَّل استخدام createsuperuser ما لم تكن "
"تعلم أنك بحاجة لهذا."

#: accounts/management/commands/create_mms_user.py:47
msgid ""
"If --staff, assign maintenance+inventory+procurement permissions so /admin/ "
"is not empty."
msgstr ""
"في حال --staff، منح صلاحيات الصيانة والمخزون والمشتريات حتى لا يكون /admin/ "
"فارغًا."

#: accounts/management/commands/create_mms_user.py:52
msgid "Unsafe for shell history; omit to be prompted securely."
msgstr "غير آمن لتاريخ Shell؛ احذفه ليُطلب منك بشكل آمن."

#: accounts/management/commands/create_mms_user.py:57
msgid "With --password only; fail if password empty."
msgstr "مع --password فقط؛ يفشل إذا كانت كلمة المرور فارغة."

#: accounts/management/commands/create_mms_user.py:64
msgid "username is required."
msgstr "اسم المستخدم مطلوب."

#: accounts/management/commands/create_mms_user.py:67
#, python-format
msgid "User %s already exists."
msgstr "المستخدم %s موجود بالفعل."

#: accounts/management/commands/create_mms_user.py:73
msgid "--no-input requires --password."
msgstr "--no-input تتطلب --password."

#: accounts/management/commands/create_mms_user.py:76
msgid "Password: "
msgstr "كلمة المرور: "

#: accounts/management/commands/create_mms_user.py:77
msgid "Password (again): "
msgstr "كلمة المرور (مرة أخرى): "

#: accounts/management/commands/create_mms_user.py:79
msgid "Passwords do not match."
msgstr "كلمتا المرور غير متطابقتَين."

#: accounts/management/commands/create_mms_user.py:82
msgid "Password is shorter than 8 characters (not recommended)."
msgstr "كلمة المرور أقصر من 8 أحرف (غير مستحسن)."

#: accounts/management/commands/create_mms_user.py:101
#, python-format
msgid "Granted maintenance/inventory/procurement admin permissions to %s."
msgstr "تم منح صلاحيات إدارة الصيانة والمخزون والمشتريات إلى %s."

#: accounts/management/commands/create_mms_user.py:108
#, python-format
msgid ""
"User is staff but has no model permissions yet — /admin/ may be empty. Run:\n"
"  python manage.py grant_staff_admin_permissions --usernames=%s"
msgstr ""
"المستخدم موظف ولكن ليست لديه صلاحيات نموذج بعد — قد يكون /admin/ فارغًا. "
"نفِّذ:\n"
"  python manage.py grant_staff_admin_permissions --usernames=%s"

#: accounts/management/commands/create_mms_user.py:118
#, python-format
msgid ""
"Created user %(username)r role=%(role)s staff=%(staff)s "
"superuser=%(superuser)s. MMS login: same username/password at site root "
"(not /admin/ unless staff)."
msgstr ""
"تم إنشاء المستخدم %(username)r دور=%(role)s موظف=%(staff)s "
"خارق=%(superuser)s. تسجيل الدخول إلى MMS: نفس اسم المستخدم وكلمة المرور في "
"جذر الموقع (وليس /admin/ ما لم يكن موظفًا)."

