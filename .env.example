# ─── MMS environment file ─────────────────────────────────────────────────
# Copy to .env and fill in real values before `docker compose up`.
# NEVER commit .env. It is listed in .gitignore.
#
# Generate a SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ──────────────────────────────────────────────────────────────────────────

# ─── Database (required) ────────────────────────────────────────────────
DB_NAME=mms_db
DB_USER=mms_user
# Replace with a strong random password. Min 16 chars.
DB_PASSWORD=change_me_to_a_strong_random_password
# DB_HOST and DB_PORT are overridden by docker-compose.yml to `db` / 5432.
# Override here only for native (non-docker) runs:
DB_HOST=localhost
DB_PORT=5432

# ─── Django core (required) ─────────────────────────────────────────────
# REQUIRED. Long random string. At minimum 50 chars.
SECRET_KEY=replace_me_with_python_secrets_token_urlsafe_50
# Production: False. Local native dev: True.
DEBUG=False
# Comma-separated hostnames the app will serve. Include the company hostname
# and any reverse-proxy aliases. NO spaces.
ALLOWED_HOSTS=mms.company.local,localhost,127.0.0.1

# ─── Gunicorn (optional) ───────────────────────────────────────────────
# Number of gunicorn worker processes. Default: 3.
# Rule of thumb: 2-4 × CPU cores, capped at ~8 for SQLite-bound or single-DB workloads.
GUNICORN_WORKERS=3

# ─── Optional first-boot superuser ──────────────────────────────────────
# Set to 1 to auto-create a superuser IF none exists. Idempotent.
# Then fill the three DJANGO_SUPERUSER_* vars below.
MMS_CREATE_SUPERUSER=0
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@company.local
# CHANGE THIS IMMEDIATELY AFTER FIRST LOGIN.
DJANGO_SUPERUSER_PASSWORD=change_me_immediately

# ─── Demo data ─────────────────────────────────────────────────────────
# Demo data is NEVER auto-seeded. To seed (manual, one-time):
#   docker compose exec web python manage.py seed_demo --full
# Intentionally no flag for auto-seeding.

# ─── SQLite fallback (CI / tests ONLY) ────────────────────────────────
# Set to 1 to bypass Postgres and use the local db.sqlite3.
# DO NOT set this in docker compose. CI / pytest does:
#   MMS_USE_SQLITE=1 python manage.py test
MMS_USE_SQLITE=

# ─── Reserved for Phase 2 (Celery / Redis / backups / monitoring) ──────
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=django-db
